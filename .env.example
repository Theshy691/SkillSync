# ==============================================================================
# SkillSync - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Google Gemini AI API Key
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project URL & Anon Public Key
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
